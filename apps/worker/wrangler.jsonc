{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chat",
  "account_id": "2b7e5184fad7157600b3368e91c4d941",
  "main": "dist/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "FriendStarHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FriendStarHub"] }],
  "ai": { "binding": "AI" },
  "vars": { "OWNER_EMAILS": "contact.tajuljayan@gmail.com" },
  "observability": { "enabled": true }
}
